{
  "name": "shopsense",
  "private": true,
  "version": "1.0.0",
  "description": "ShopShare — a multi-vendor marketplace with AI-powered natural-language search, recommendations and a shopping assistant.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @shopsense/api test:e2e",
    "db:migrate": "pnpm --filter @shopsense/api db:migrate",
    "db:deploy": "pnpm --filter @shopsense/api db:deploy",
    "db:seed": "pnpm --filter @shopsense/api db:seed",
    "db:reset": "pnpm --filter @shopsense/api db:reset",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
