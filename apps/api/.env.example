# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shopsense:shopsense@localhost:5432/shopsense
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Optional Google login (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------- payments (Stripe TEST mode)
# Leave empty to use mock payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ORDER_EXPIRY_MINUTES=35

# ---------------------------------------------------------------- images
# Leave empty to store images on local disk (fine for development).
CLOUDINARY_URL=
UPLOAD_DIR=uploads

# ---------------------------------------------------------------- AI
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY, else rule-based fallbacks (free).
LLM_PROVIDER=auto
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible API. Free option: Google Gemini
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=<your Gemini key>   LLM_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://api.openai.com/v1
# local = free built-in embedder (no key). openai = OpenAI-compatible embeddings (always 768 dims).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------------------------------------------------------------- email
# Resend (https://resend.com) or any SMTP server. Leave both empty to print emails to the log.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopShare <onboarding@resend.dev>

# ---------------------------------------------------------------- misc
DEMO_MODE=true
CACHE_TTL_SECONDS=120
THROTTLE_DISABLED=false
TRUST_PROXY_HOPS=1
