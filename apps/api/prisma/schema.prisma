// ShopShare database schema.
// Money is always stored as integers in satang (1 THB = 100 satang).

generator client {
  provider        = "prisma-client-js"
  // Rust-free client: smaller, faster cold starts on Render/Railway, talks to Postgres via `pg`.
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String?        @map("password_hash")
  name         String
  avatarUrl    String?        @map("avatar_url")
  role         Role           @default(BUYER)
  googleId     String?        @unique @map("google_id")
  isBanned     Boolean        @default(false) @map("is_banned")
  isDemo       Boolean        @default(false) @map("is_demo")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sellerProfile SellerProfile?
  products     Product[]
  cart         Cart?
  orders       Order[]
  soldItems    OrderItem[]    @relation("SellerOrderItems")
  reviews      Review[]
  wishlist     Wishlist[]
  views        ProductView[]

  @@index([role])
  @@map("users")
}

model SellerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique @map("user_id")
  storeName   String       @map("store_name")
  slug        String       @unique
  description String?
  logoUrl     String?      @map("logo_url")
  bannerUrl   String?      @map("banner_url")
  status      SellerStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("seller_profiles")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  imageUrl    String?   @map("image_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String            @id @default(cuid())
  sellerId    String            @map("seller_id")
  categoryId  String            @map("category_id")
  title       String
  slug        String            @unique
  description String
  /// satang
  price       Int
  /// Original price in satang, shown crossed out when the product is on sale.
  compareAtPrice Int?           @map("compare_at_price")
  brand       String?
  /// Total sellable stock. When variants exist this is the sum of variant stock.
  stock       Int               @default(0)
  status      ProductStatus     @default(DRAFT)
  tags        String[]          @default([])
  ratingAvg   Float             @default(0) @map("rating_avg")
  ratingCount Int               @default(0) @map("rating_count")
  salesCount  Int               @default(0) @map("sales_count")
  viewCount   Int               @default(0) @map("view_count")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  seller      User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]
  embedding   ProductEmbedding?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistedBy Wishlist[]
  views       ProductView[]

  @@index([status, categoryId])
  @@index([sellerId])
  @@index([price])
  @@map("products")
}

model ProductVariant {
  id        String     @id @default(cuid())
  productId String     @map("product_id")
  size      String?
  colour    String?
  sku       String?
  stock     Int        @default(0)
  /// Optional override in satang
  price     Int?
  position  Int        @default(0)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  position  Int     @default(0)
  publicId  String? @map("public_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductEmbedding {
  productId   String                     @id @map("product_id")
  embedding   Unsupported("vector(768)")
  model       String
  contentHash String                     @map("content_hash")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  product     Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String          @map("cart_id")
  productId String          @map("product_id")
  variantId String?         @map("variant_id")
  quantity  Int
  createdAt DateTime        @default(now()) @map("created_at")
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  buyerId         String      @map("buyer_id")
  status          OrderStatus @default(PENDING)
  /// satang
  subtotal        Int
  /// satang
  total           Int
  currency        String      @default("thb")
  /// Orders created by one checkout share a group id (one order per seller, one payment).
  checkoutGroup   String      @map("checkout_group")
  stripeSessionId String?     @map("stripe_session_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  shippingAddress Json?       @map("shipping_address")
  trackingNumber  String?     @map("tracking_number")
  expiresAt       DateTime?   @map("expires_at")
  paidAt          DateTime?   @map("paid_at")
  shippedAt       DateTime?   @map("shipped_at")
  deliveredAt     DateTime?   @map("delivered_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  buyer           User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]

  @@index([buyerId, createdAt])
  @@index([status])
  @@index([checkoutGroup])
  @@index([stripeSessionId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  productId    String?  @map("product_id")
  variantId    String?  @map("variant_id")
  sellerId     String   @map("seller_id")
  title        String
  variantLabel String?  @map("variant_label")
  imageUrl     String?  @map("image_url")
  /// satang
  unitPrice    Int      @map("unit_price")
  quantity     Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  seller       User     @relation("SellerOrderItems", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  provider    String
  providerRef String   @unique @map("provider_ref")
  /// satang
  amount      Int
  currency    String   @default("thb")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

/// Every Stripe event we have processed. The primary key makes webhook handling idempotent.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
}

model Review {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Int
  title     String?
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@map("product_views")
}
